<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CarbSeek Insight | 碳产业研发情报驾驶舱</title>
<style>
:root {
  --bg-primary: #0a0e17;
  --bg-secondary: #111827;
  --bg-card: #1a2332;
  --bg-card-hover: #1e293b;
  --border-color: #253044;
  --text-primary: #e2e8f0;
  --text-secondary: #94a3b8;
  --accent-green: #10b981;
  --accent-blue: #3b82f6;
  --accent-amber: #f59e0b;
  --accent-red: #ef4444;
  --accent-purple: #8b5cf6;
  --accent-cyan: #06b6d4;
  --font-mono: 'SF Mono', Monaco, 'Cascadia Code', monospace;
  --font-sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

* { margin: 0; padding: 0; box-sizing: border-box; }

body {
  background: var(--bg-primary);
  color: var(--text-primary);
  font-family: var(--font-sans);
  line-height: 1.6;
  min-height: 100vh;
}

/* ===== Header ===== */
.header {
  background: var(--bg-secondary);
  border-bottom: 1px solid var(--border-color);
  padding: 0 24px;
  position: sticky;
  top: 0;
  z-index: 100;
}

.header-inner {
  max-width: 1440px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 60px;
}

.logo {
  display: flex;
  align-items: center;
  gap: 10px;
  font-weight: 700;
  font-size: 18px;
  color: var(--text-primary);
}

.logo-icon {
  width: 32px; height: 32px;
  background: linear-gradient(135deg, var(--accent-green), var(--accent-cyan));
  border-radius: 8px;
  display: flex; align-items: center; justify-content: center;
  font-size: 14px;
}

.nav-tabs {
  display: flex;
  gap: 4px;
}

.nav-tab {
  padding: 8px 16px;
  border-radius: 6px;
  font-size: 13px;
  font-weight: 500;
  color: var(--text-secondary);
  text-decoration: none;
  transition: all 0.2s;
}

.nav-tab:hover, .nav-tab.active {
  background: rgba(59, 130, 246, 0.15);
  color: var(--accent-blue);
}

.header-meta {
  display: flex;
  align-items: center;
  gap: 16px;
  font-size: 12px;
  color: var(--text-secondary);
}

.badge {
  padding: 2px 8px;
  border-radius: 4px;
  font-size: 11px;
  font-weight: 600;
}

.badge-live {
  background: rgba(16, 185, 129, 0.15);
  color: var(--accent-green);
}

/* ===== Main Layout ===== */
.main {
  max-width: 1440px;
  margin: 0 auto;
  padding: 24px;
}

/* ===== Hero: One Sentence Judgment ===== */
.judgment-banner {
  background: linear-gradient(135deg, rgba(59, 130, 246, 0.1), rgba(139, 92, 246, 0.1));
  border: 1px solid rgba(59, 130, 246, 0.2);
  border-radius: 12px;
  padding: 20px 24px;
  margin-bottom: 24px;
  display: flex;
  align-items: flex-start;
  gap: 16px;
}

.judgment-icon {
  width: 40px; height: 40px;
  background: rgba(59, 130, 246, 0.15);
  border-radius: 10px;
  display: flex; align-items: center; justify-content: center;
  font-size: 20px;
  flex-shrink: 0;
}

.judgment-content h2 {
  font-size: 13px;
  font-weight: 600;
  color: var(--accent-blue);
  margin-bottom: 6px;
  letter-spacing: 0.5px;
}

.judgment-content p {
  font-size: 15px;
  line-height: 1.7;
  color: var(--text-primary);
}

/* ===== Grid Layout ===== */
.grid-2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
.grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
.grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }

@media (max-width: 1200px) {
  .grid-4 { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 768px) {
  .grid-2, .grid-3, .grid-4 { grid-template-columns: 1fr; }
}

/* ===== Cards ===== */
.card {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 12px;
  overflow: hidden;
}

.card-header {
  padding: 16px 20px;
  border-bottom: 1px solid var(--border-color);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-title {
  font-size: 14px;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 8px;
}

.card-title-icon {
  width: 8px; height: 8px;
  border-radius: 50%;
}

.card-body {
  padding: 16px 20px;
}

.card-footer {
  padding: 12px 20px;
  border-top: 1px solid var(--border-color);
  font-size: 12px;
  color: var(--text-secondary);
}

/* ===== Severity Indicators ===== */
.severity {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: 11px;
  font-weight: 600;
  padding: 2px 8px;
  border-radius: 4px;
}

.severity-critical {
  background: rgba(239, 68, 68, 0.15);
  color: var(--accent-red);
}

.severity-high {
  background: rgba(245, 158, 11, 0.15);
  color: var(--accent-amber);
}

.severity-medium {
  background: rgba(59, 130, 246, 0.15);
  color: var(--accent-blue);
}

.severity-low {
  background: rgba(16, 185, 129, 0.15);
  color: var(--accent-green);
}

/* ===== Radar List ===== */
.radar-item {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 14px 0;
  border-bottom: 1px solid var(--border-color);
}

.radar-item:last-child { border-bottom: none; padding-bottom: 0; }
.radar-item:first-child { padding-top: 0; }

.radar-number {
  width: 24px; height: 24px;
  background: var(--bg-secondary);
  border-radius: 6px;
  display: flex; align-items: center; justify-content: center;
  font-size: 11px;
  font-weight: 700;
  flex-shrink: 0;
}

.radar-content { flex: 1; }

.radar-title {
  font-size: 13px;
  font-weight: 600;
  margin-bottom: 4px;
  line-height: 1.5;
}

.radar-meta {
  display: flex;
  gap: 10px;
  align-items: center;
  font-size: 11px;
  color: var(--text-secondary);
}

.radar-tag {
  padding: 1px 6px;
  border-radius: 3px;
  font-size: 10px;
  font-weight: 500;
  background: rgba(59, 130, 246, 0.1);
  color: var(--accent-blue);
}

/* ===== Opportunity Cards ===== */
.opp-item {
  display: flex;
  gap: 14px;
  padding: 16px;
  border-bottom: 1px solid var(--border-color);
  transition: background 0.2s;
}

.opp-item:hover {
  background: var(--bg-card-hover);
}

.opp-item:last-child { border-bottom: none; }

.opp-rank {
  width: 32px; height: 32px;
  border-radius: 8px;
  display: flex; align-items: center; justify-content: center;
  font-size: 13px;
  font-weight: 700;
  flex-shrink: 0;
}

.opp-rank.p0 { background: rgba(239, 68, 68, 0.15); color: var(--accent-red); }
.opp-rank.p1 { background: rgba(245, 158, 11, 0.15); color: var(--accent-amber); }
.opp-rank.p2 { background: rgba(16, 185, 129, 0.15); color: var(--accent-green); }

.opp-content { flex: 1; }

.opp-title {
  font-size: 13px;
  font-weight: 600;
  margin-bottom: 6px;
  line-height: 1.5;
}

.opp-meta {
  display: flex;
  gap: 12px;
  align-items: center;
  font-size: 11px;
  color: var(--text-secondary);
  flex-wrap: wrap;
}

.opp-score {
  display: flex;
  gap: 8px;
}

.score-pill {
  padding: 1px 6px;
  border-radius: 3px;
  font-size: 10px;
  font-weight: 600;
}

.score-pill.biz { background: rgba(59, 130, 246, 0.1); color: var(--accent-blue); }
.score-pill.tech { background: rgba(16, 185, 129, 0.1); color: var(--accent-green); }
.score-pill.grade-a { background: rgba(139, 92, 246, 0.1); color: var(--accent-purple); }

/* ===== Countdown ===== */
.countdown-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 0;
  border-bottom: 1px solid var(--border-color);
}

.countdown-item:last-child { border-bottom: none; padding-bottom: 0; }
.countdown-item:first-child { padding-top: 0; }

.countdown-days {
  width: 48px; height: 48px;
  border-radius: 10px;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  font-family: var(--font-mono);
  flex-shrink: 0;
}

.countdown-days.critical {
  background: rgba(239, 68, 68, 0.15);
  color: var(--accent-red);
}

.countdown-days.high {
  background: rgba(245, 158, 11, 0.15);
  color: var(--accent-amber);
}

.countdown-days .days-num {
  font-size: 16px;
  font-weight: 700;
  line-height: 1;
}

.countdown-days .days-label {
  font-size: 9px;
  margin-top: 2px;
}

.countdown-info { flex: 1; }

.countdown-title {
  font-size: 12px;
  font-weight: 600;
  margin-bottom: 2px;
}

.countdown-deadline {
  font-size: 11px;
  color: var(--text-secondary);
}

/* ===== Industry Trend ===== */
.trend-bar {
  margin-bottom: 16px;
}

.trend-bar:last-child { margin-bottom: 0; }

.trend-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6px;
}

.trend-name {
  font-size: 13px;
  font-weight: 500;
}

.trend-score {
  font-family: var(--font-mono);
  font-size: 13px;
  font-weight: 700;
}

.trend-change {
  font-size: 11px;
  margin-left: 6px;
}

.trend-change.up { color: var(--accent-red); }

.trend-track {
  height: 6px;
  background: var(--bg-secondary);
  border-radius: 3px;
  overflow: hidden;
}

.trend-fill {
  height: 100%;
  border-radius: 3px;
  transition: width 0.5s ease;
}

.trend-fill.chemical { background: linear-gradient(90deg, var(--accent-blue), var(--accent-cyan)); }
.trend-fill.electronics { background: linear-gradient(90deg, var(--accent-purple), var(--accent-blue)); }
.trend-fill.automotive { background: linear-gradient(90deg, var(--accent-amber), var(--accent-red)); }
.trend-fill.eu-export { background: linear-gradient(90deg, var(--accent-red), var(--accent-amber)); }

.trend-theme {
  font-size: 11px;
  color: var(--text-secondary);
  margin-top: 4px;
}

/* ===== Competitor Intel ===== */
.comp-item {
  display: flex;
  gap: 12px;
  padding: 12px 0;
  border-bottom: 1px solid var(--border-color);
}

.comp-item:last-child { border-bottom: none; padding-bottom: 0; }
.comp-item:first-child { padding-top: 0; }

.comp-avatar {
  width: 36px; height: 36px;
  background: var(--bg-secondary);
  border-radius: 8px;
  display: flex; align-items: center; justify-content: center;
  font-size: 11px;
  font-weight: 700;
  color: var(--text-secondary);
  flex-shrink: 0;
}

.comp-content { flex: 1; }

.comp-name {
  font-size: 12px;
  font-weight: 600;
  margin-bottom: 2px;
}

.comp-action {
  font-size: 12px;
  color: var(--text-primary);
  margin-bottom: 2px;
}

.comp-impact {
  font-size: 11px;
  color: var(--text-secondary);
}

/* ===== RD Suggestions ===== */
.rd-item {
  display: flex;
  gap: 10px;
  padding: 12px 0;
  border-bottom: 1px solid var(--border-color);
  align-items: flex-start;
}

.rd-item:last-child { border-bottom: none; padding-bottom: 0; }
.rd-item:first-child { padding-top: 0; }

.rd-priority {
  padding: 2px 8px;
  border-radius: 4px;
  font-size: 10px;
  font-weight: 700;
  flex-shrink: 0;
}

.rd-priority.p0 {
  background: rgba(239, 68, 68, 0.15);
  color: var(--accent-red);
}

.rd-priority.p1 {
  background: rgba(245, 158, 11, 0.15);
  color: var(--accent-amber);
}

.rd-priority.p2 {
  background: rgba(16, 185, 129, 0.15);
  color: var(--accent-green);
}

.rd-text {
  font-size: 12px;
  line-height: 1.6;
  flex: 1;
}

/* ===== Impact Cards ===== */
.impact-card {
  padding: 16px;
  border-radius: 10px;
  border: 1px solid var(--border-color);
}

.impact-card.pro { border-color: rgba(59, 130, 246, 0.3); }
.impact-card.scan { border-color: rgba(16, 185, 129, 0.3); }
.impact-card.db { border-color: rgba(139, 92, 246, 0.3); }

.impact-title {
  font-size: 12px;
  font-weight: 700;
  margin-bottom: 8px;
  display: flex;
  align-items: center;
  gap: 6px;
}

.impact-title.pro { color: var(--accent-blue); }
.impact-title.scan { color: var(--accent-green); }
.impact-title.db { color: var(--accent-purple); }

.impact-text {
  font-size: 12px;
  line-height: 1.7;
  color: var(--text-secondary);
}

/* ===== Section Divider ===== */
.section-title {
  font-size: 16px;
  font-weight: 700;
  margin: 32px 0 16px;
  display: flex;
  align-items: center;
  gap: 8px;
}

.section-title::before {
  content: '';
  width: 4px; height: 20px;
  background: var(--accent-blue);
  border-radius: 2px;
}

/* ===== Links ===== */
.page-link {
  color: var(--accent-blue);
  text-decoration: none;
  font-size: 12px;
}

.page-link:hover {
  text-decoration: underline;
}

/* ===== Scrollbar ===== */
::-webkit-scrollbar { width: 8px; }
::-webkit-scrollbar-track { background: var(--bg-primary); }
::-webkit-scrollbar-thumb { background: var(--border-color); border-radius: 4px; }
::-webkit-scrollbar-thumb:hover { background: #334155; }
</style>
</head>
<body>

<!-- Header -->
<header class="header">
  <div class="header-inner">
    <div class="logo">
      <div class="logo-icon">🌿</div>
      <span>CarbSeek Insight</span>
    </div>
    <nav class="nav-tabs">
      <a href="index.html" class="nav-tab active">本周产业雷达</a>
      <a href="industry-chemical.html" class="nav-tab">化工</a>
      <a href="industry-electronics.html" class="nav-tab">电子电气</a>
      <a href="industry-automotive.html" class="nav-tab">汽车</a>
      <a href="industry-eu-export.html" class="nav-tab">欧盟出口</a>
      <a href="evidence.html" class="nav-tab">证据库</a>
      <a href="opportunities.html" class="nav-tab">机会库</a>
    </nav>
    <div class="header-meta">
      <span class="badge badge-live">● 实时追踪</span>
      <span>WR-2026-W30 | 截至 2026.07.27</span>
    </div>
  </div>
</header>

<!-- Main Content -->
<main class="main">

  <!-- One Sentence Judgment -->
  <div class="judgment-banner">
    <div class="judgment-icon">💡</div>
    <div class="judgment-content">
      <h2>本周一句话判断</h2>
      <p>生态环境部发布《产品碳足迹管理体系建设进展报告（2026）》，20余省市已编制地方碳足迹管理方案；宁德时代拿下锂电池行业首张碳足迹标识认证；CBAM 正式实施后引入 50 吨豁免门槛和机加工排除规则， CarbSeek 需在 Q3 完成因子库 API 和 CBAM 自动化模块立项。</p>
    </div>
  </div>

  <!-- Top Section: Radar + Countdown + Trends -->
  <div class="grid-3">
    <!-- Radar Top 5 -->
    <div class="card" style="grid-column: span 2;">
      <div class="card-header">
        <div class="card-title">
          <span class="card-title-icon" style="background: var(--accent-red);"></span>
          本周重大变化 Top 5
        </div>
        <a href="evidence.html" class="page-link">查看全部 →</a>
      </div>
      <div class="card-body">
        <div class="radar-item">
          <div class="radar-number">1</div>
          <div class="radar-content">
            <div class="radar-title">欧盟 CBAM Q2 申报指南更新：新增 47 类钢铁下游产品追溯</div>
            <div class="radar-meta">
              <span class="severity severity-critical">CRITICAL</span>
              <span class="radar-tag">政策变化</span>
              <span>欧盟出口</span>
              <span>2026-07-01</span>
            </div>
          </div>
        </div>
        <div class="radar-item">
          <div class="radar-number">2</div>
          <div class="radar-content">
            <div class="radar-title">生态环境部发布《产品碳足迹管理体系建设进展报告（2026）》：20 余省市已编制地方碳足迹管理方案</div>
            <div class="radar-meta">
              <span class="severity severity-critical">CRITICAL</span>
              <span class="radar-tag">政策变化</span>
              <span>通用</span>
              <span>2026-06-18</span>
            </div>
          </div>
        </div>
        <div class="radar-item">
          <div class="radar-number">3</div>
          <div class="radar-content">
            <div class="radar-title">宁德时代 EnerD+ 储能产品拿下锂电池行业首张产品碳足迹标识认证证书</div>
            <div class="radar-meta">
              <span class="severity severity-high">HIGH</span>
              <span class="radar-tag">竞品动作</span>
              <span>汽车</span>
              <span>2026-06-29</span>
            </div>
          </div>
        </div>
        <div class="radar-item">
          <div class="radar-number">4</div>
          <div class="radar-content">
            <div class="radar-title">欧盟电池法规碳足迹性能分级（A-E 级）将于 2026 年 8 月 18 日实施</div>
            <div class="radar-meta">
              <span class="severity severity-high">HIGH</span>
              <span class="radar-tag">政策变化</span>
              <span>汽车</span>
              <span>2026-06-25</span>
            </div>
          </div>
        </div>
        <div class="radar-item">
          <div class="radar-number">5</div>
          <div class="radar-content">
            <div class="radar-title">CBAM 正式实施引入 50 吨豁免门槛：约 80% 进口商豁免申报</div>
            <div class="radar-meta">
              <span class="severity severity-high">HIGH</span>
              <span class="radar-tag">政策变化</span>
              <span>欧盟出口</span>
              <span>2026-06-30</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Policy Countdown -->
    <div class="card">
      <div class="card-header">
        <div class="card-title">
          <span class="card-title-icon" style="background: var(--accent-amber);"></span>
          政策倒计时
        </div>
      </div>
      <div class="card-body">
        <div class="countdown-item">
          <div class="countdown-days critical">
            <span class="days-num">66</span>
            <span class="days-label">天</span>
          </div>
          <div class="countdown-info">
            <div class="countdown-title">CBAM 正式征收（取消免费配额）</div>
            <div class="countdown-deadline">Deadline: 2026-10-01</div>
          </div>
        </div>
        <div class="countdown-item">
          <div class="countdown-days high">
            <span class="days-num">157</span>
            <span class="days-label">天</span>
          </div>
          <div class="countdown-info">
            <div class="countdown-title">韩国电子电气碳标签过渡期结束</div>
            <div class="countdown-deadline">Deadline: 2026-12-31</div>
          </div>
        </div>
        <div class="countdown-item">
          <div class="countdown-days critical">
            <span class="days-num">206</span>
            <span class="days-label">天</span>
          </div>
          <div class="countdown-info">
            <div class="countdown-title">欧盟电池法规碳足迹强制声明</div>
            <div class="countdown-deadline">Deadline: 2027-02-18</div>
          </div>
        </div>
        <div class="countdown-item">
          <div class="countdown-days high">
            <span class="days-num">158</span>
            <span class="days-label">天</span>
          </div>
          <div class="countdown-info">
            <div class="countdown-title">CBAM 扩大至有机化学品、塑料</div>
            <div class="countdown-deadline">Deadline: 2027-01-01</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Industry Trends -->
  <h2 class="section-title">行业热度趋势</h2>
  <div class="grid-4">
    <div class="card">
      <div class="card-body">
        <div class="trend-bar">
          <div class="trend-header">
            <span class="trend-name">🔬 化工</span>
            <span>
              <span class="trend-score">78</span>
              <span class="trend-change up">↑5</span>
            </span>
          </div>
          <div class="trend-track">
            <div class="trend-fill chemical" style="width: 78%;"></div>
          </div>
